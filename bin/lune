#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$ROOT_DIR:$PYTHONPATH"
else
    export PYTHONPATH="$ROOT_DIR"
fi

# lune.cli starts the REPL itself when no file/subcommand remains after
# global flags (e.g. `lune`, `lune --lang ja`); LUNE_LANG passes through exec.
exec python3 -m lune.cli "$@"
