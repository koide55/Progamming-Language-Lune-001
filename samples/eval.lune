module sample.eval

type Option[T] =
    | Some(value: T)
    | None

def first(a: Int, b: Int): Int =
    a

def getOrElse[T](option: Option[T], defaultValue: T): T =
    match option:
        | Some(value) -> value
        | None -> defaultValue

let lazySafe = first(10, crash())
let matched = getOrElse(Some(42), 0)
let nested =
    let x = 20
    let y = 22
    x + y
