module sample.pipeline

def inc(n: Int): Int =
    n + 1

def double(n: Int): Int =
    n * 2

def add(x: Int, y: Int): Int =
    x + y

# `x |> f` is sugar for `f(x)`; it type-checks and evaluates as the call.
let result = 5 |> inc |> double

# Pipelining into a multi-arg function partially applies it.
let addFive = 5 |> add
let eleven = addFive(6)
